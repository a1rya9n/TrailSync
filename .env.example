# ==========================================
# TrailSync — Environment Configuration
# ==========================================

# 1. Google AI Studio API Key for Gemma 2
# Obtain your free API key at: https://aistudio.google.com/app/apikey
VITE_GEMMA_API_KEY=

# 2. Selected Gemma Model Identifier
# Default: gemma-2-9b-it (Google's open-weights model)
# Alternative options: gemma-2-27b-it, or groq: gemma2-9b-it
VITE_GEMMA_MODEL=gemma-2-9b-it

# 3. Model Provider
# Options: 'google' (Google AI Studio) | 'groq' | 'ollama' | 'openrouter'
VITE_GEMMA_PROVIDER=google
